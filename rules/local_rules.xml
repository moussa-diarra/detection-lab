<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>
<group name="detection_lab,">

  <!-- T1059.001 : PowerShell lancé avec une commande encodée -->
  <rule id="100110" level="12">
    <if_sid>61603, 92057, 92032</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^(powershell\.exe|pwsh\.dll)$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s[-/](e|ec|en[a-z]*)\s+[a-z0-9+/=]{16,}</field>
    <description>T1059.001 - PowerShell lancé avec une commande encodée sur $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- T1547.001 : persistance par clé de registre Run / RunOnce -->
  <rule id="100120" level="10">
    <if_sid>61615, 92300</if_sid>
    <field name="win.eventdata.eventType">^SetValue$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+CurrentVersion\\+Run(Once)?\\+</field>
    <description>T1547.001 - Valeur ajoutée dans une clé Run : $(win.eventdata.targetObject)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- T1053.005 : tâche planifiée créée (événement 4698) -->
  <rule id="100130" level="10">
    <if_sid>60228</if_sid>
    <field name="win.system.eventID">^4698$</field>
    <description>T1053.005 - Tâche planifiée créée : $(win.eventdata.taskName) par $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- T1136.001 : compte local créé (événement 4720) -->
  <rule id="100140" level="10">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>T1136.001 - Compte créé : $(win.eventdata.targetUserName) par $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>
  <!-- T1070.001 : journal Windows effacé (1102 = Security, 104 = autres journaux) -->
  <rule id="100150" level="12">
    <if_sid>63103, 63104</if_sid>
    <description>T1070.001 - Journal Windows effacé sur $(win.system.computer) (événement $(win.system.eventID))</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

  <!-- T1562.001 : protection Defender désactivée -->
  <rule id="100160" level="12">
    <if_sid>62152</if_sid>
    <description>T1562.001 - Protection Microsoft Defender désactivée sur $(win.system.computer)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <!-- T1003.001 : fichier de vidage mémoire créé par un outil de vidage -->
  <rule id="100170" level="12">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.dmp$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+(procdump64|procdump|rundll32|taskmgr|createdump)\.exe$</field>
    <description>T1003.001 - Fichier de vidage créé par $(win.eventdata.image) : $(win.eventdata.targetFilename)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>
     <!-- T1558.003 : Kerberoasting - ticket de service RC4 pour un SPN porté par un compte utilisateur -->
  <rule id="100180" level="12">
    <if_sid>60106</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <field name="win.eventdata.serviceName" type="pcre2">(?i)^(?!.*\$$).+$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(?!.*\$@).+$</field>
    <description>T1558.003 - Kerberoasting : ticket RC4 demandé pour le service $(win.eventdata.serviceName) par $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
  </rule>
    <!-- Exclusion FP : VBoxTray (agent invité VirtualBox), clé Run légitime -->
  <rule id="100121" level="0">
    <if_sid>100120</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+CurrentVersion\\+Run\\+VBoxTray$</field>
    <description>FP exclu : enregistrement Run légitime de VBoxTray (VirtualBox)</description>
  </rule>

  <!-- Exclusion FP : tâche Windows Defender créée par le système -->
  <rule id="100131" level="0">
    <if_sid>100130</if_sid>
    <field name="win.eventdata.taskName" type="pcre2">(?i)^\\+Microsoft\\+Windows\\+Windows Defender\\+Windows Defender Scheduled Scan$</field>
    <field name="win.eventdata.subjectUserName" type="pcre2">(?i)\$$</field>
    <description>FP exclu : tâche planifiée système Windows Defender Scheduled Scan</description>
  </rule>
</group>
